<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- TODO: Really these are sensitive permissions, should probably make callers add them
       although, like why would you want the downloads to be interruptible? That would be silly
       And you can't configure the foreground notification ID the way that I have this set up

       OK we just go with the original plan - Caller declares all of these in order to use the
       Service, or implements their own Service at whatever foreground level they want
  -->

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
  <!-- Lets PlatformScheduler restart downloads after a device reboot -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

  <application>
    <service
      android:name="com.mux.player.offline.MuxDownloadService"
      android:foregroundServiceType="dataSync"
      android:exported="false"
      >
      <intent-filter>
        <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
    </service>

    <!-- JobService used by PlatformScheduler (MuxDownloadService.getScheduler()) to reschedule
         downloads when their requirements are met and after a reboot -->
    <service
      android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
      android:permission="android.permission.BIND_JOB_SERVICE"
      android:exported="true"/>
  </application>
</manifest>
